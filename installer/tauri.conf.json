{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Shelf Setup",
  "version": "0.1.0",
  "identifier": "com.ai-shelf.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
