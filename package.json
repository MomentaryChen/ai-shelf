{
  "name": "ai-cli-inventory-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "AI CLI Inventory monorepo — inventory, workspace orchestration, and desktop app",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm build:cli && tsc && vite build && node -e \"const fs=require('fs');fs.copyFileSync('src/electron/preload.cjs','dist/electron/preload.cjs');fs.mkdirSync('dist/assets',{recursive:true});fs.copyFileSync('src/assets/icon.ico','dist/assets/icon.ico');\"",
    "build:cli": "pnpm --filter ai-cli-inventory run build",
    "build:desktop": "pnpm run build",
    "dev": "tsc --watch",
    "dev:cli": "pnpm --filter ai-cli-inventory run dev",
    "dev:renderer": "vite",
    "start": "node dist/cli.js",
    "electron": "pnpm build && electron .",
    "electron:dev": "electron .",
    "package:win": "pnpm build && pkg . --targets node22-win-x64 --output dist/ai-inventory.exe",
    "dist:win": "pnpm build && electron-builder --win",
    "test:e2e": "pnpm build && playwright test",
    "gen-icon": "node scripts/gen-icon.mjs",
    "lint": "pnpm -r run lint --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "rebuild:native:all": "node scripts/rebuild-native.mjs --all"
  },
  "build": {
    "appId": "com.ai-cli-inventory",
    "productName": "AI CLI Inventory",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/assets/icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "src/assets/icon.ico"
    }
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "assets": []
  },
  "keywords": [
    "ai",
    "cli",
    "inventory",
    "claude",
    "copilot",
    "cursor",
    "mcp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@electron/rebuild": "^4.0.4",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@yao-pkg/pkg": "^6.19.0",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "ai-cli-inventory": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
