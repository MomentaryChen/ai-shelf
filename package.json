{
  "name": "ai-shelf-workspace",
  "private": true,
  "version": "3.4.0",
  "description": "AI Shelf monorepo — inventory, workspace orchestration, and desktop app",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm build:cli && tsc && tsc -p src/renderer/tsconfig.json && vite build && node -e \"const fs=require('fs');fs.copyFileSync('src/electron/preload.cjs','dist/electron/preload.cjs');fs.mkdirSync('dist/assets',{recursive:true});fs.copyFileSync('src/assets/icon.ico','dist/assets/icon.ico');\"",
    "build:cli": "pnpm --filter ai-shelf run build",
    "build:desktop": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc -p src/renderer/tsconfig.json",
    "dev": "tsc --watch",
    "dev:cli": "pnpm --filter ai-shelf run dev",
    "dev:renderer": "vite",
    "start": "node dist/cli.js",
    "electron": "pnpm build && electron .",
    "electron:dev": "electron .",
    "package:win": "pnpm build && pkg . --targets node22-win-x64 --output dist/ai-shelf.exe",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:win:signed": "pwsh -NoProfile -File scripts/dist-win-signed.ps1",
    "dist:win:portable": "pnpm build && electron-builder --win portable",
    "test:e2e": "pnpm build && playwright test",
    "gen:terminal-demo-gif": "pnpm build && node scripts/run-terminal-demo-gif.mjs",
    "gen:docs-assets": "node scripts/gen-docs-assets.mjs",
    "verify:firebase": "node scripts/verify-firebase-env.mjs",
    "gen-icon": "node scripts/gen-icon.mjs",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "rebuild:native:all": "node scripts/rebuild-native.mjs --all"
  },
  "build": {
    "appId": "com.ai-shelf",
    "productName": "AI Shelf",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/assets/icon.ico"
    ],
    "publish": {
      "provider": "github",
      "owner": "MomentaryChen",
      "repo": "ai-shelf"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "signtoolOptions": {
        "publisherName": "AI Shelf (Self-Signed)",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "guid": "com.ai-shelf",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Shelf",
      "artifactName": "AI-Shelf-Setup-${version}.${ext}",
      "uninstallDisplayName": "AI Shelf"
    }
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "assets": []
  },
  "keywords": [
    "ai",
    "ai-shelf",
    "cli",
    "inventory",
    "shelf",
    "claude",
    "copilot",
    "cursor",
    "mcp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@yao-pkg/pkg": "^6.19.0",
    "electron": "^41.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.2",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.11"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "6.1.0-beta.287",
    "ai-shelf": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "fflate": "^0.8.3",
    "firebase": "^12.15.0",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
