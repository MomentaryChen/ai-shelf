// Deploy in Firebase Console → Firestore Database → Rules → Publish
// (Create a Firestore database first if you have not already.)
//
// Path used by the app: users/{uid}/sync/state

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
