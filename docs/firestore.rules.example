// Deploy in Firebase Console → Firestore Database → Rules → Publish
// (Create a Firestore database first if you have not already.)
//
// Paths used by the app:
//   users/{uid}/sync/state     — per-user sync bundle
//   _meta/sync-registry        — global cap (300 registered sync users)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /_meta/sync-registry {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.count == 1
        && request.resource.data.users[request.auth.uid] != null;

      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.users)
        && request.auth.uid in request.resource.data.users
        && request.resource.data.count == resource.data.count + 1
        && (
          (!exists(/databases/$(database)/documents/users/$(request.auth.uid)/sync/state)
            && request.resource.data.count <= 300)
          || exists(/databases/$(database)/documents/users/$(request.auth.uid)/sync/state)
        );
    }
  }
}
