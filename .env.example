# Firebase (Google sign-in + cloud sync)
# Copy to .env or .env.local at the repo root, then: pnpm build
#
# === Firebase Console checklist (do ALL before sign-in) ===
# 1. Project settings → Your apps → Web app → copy config below
# 2. Build → Authentication → Get started (first-time only)
# 3. Authentication → Sign-in method → Google → Enable → Save
# 4. Authentication → Settings → Authorized domains → ensure "localhost" exists
# 5. Build → Firestore Database → Create database (for profile sync)
# 6. Deploy docs/firestore.rules.example in Firestore → Rules
# 7. Google Cloud → APIs → ensure "Identity Toolkit API" is enabled (usually auto)
#
# Verify locally: pnpm verify:firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional (recommended)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# authDomain must be: <projectId>.firebaseapp.com (from the same Web app config)

# GitHub Release CI: same VITE_FIREBASE_* names as repository Actions secrets
