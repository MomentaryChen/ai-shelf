{
  "name": "ai-shelf",
  "version": "2.1.10",
  "description": "AI Shelf — terminal profile CLI and TUI (shared data model with the desktop app)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "ai-shelf": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MomentaryChen/ai-shelf.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MomentaryChen/ai-shelf#readme",
  "bugs": "https://github.com/MomentaryChen/ai-shelf/issues",
  "keywords": [
    "ai",
    "ai-shelf",
    "cli",
    "claude",
    "copilot",
    "cursor",
    "mcp",
    "terminal",
    "profile"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx watch src/cli/main.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "neo-blessed": "^0.2.0",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/blessed": "^0.1.25",
    "@types/node": "^25.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
